# Copia este archivo como backend/.env y completa los valores reales.
# Nunca subas backend/.env al repositorio.

# PostgreSQL en Neon. Solo se usa en el servidor; jamás en VITE_*.
DATABASE_URL=postgresql://usuario:contrasena@host.neon.tech/basedatos?sslmode=require
# Neon requiere TLS. Usa DB_SSL=false solo contra un PostgreSQL local sin TLS.
DB_SSL=true

PORT=3000

# Orígenes permitidos por CORS, separados por coma (Vite suele usar 5173).
CORS_ORIGIN=http://localhost:5173

# Coste de bcrypt. 12 es adecuado para producción; baja el valor en pruebas.
BCRYPT_ROUNDS=12

# Límite de intentos para POST /api/auth/register (ventana en ms y máximo).
REGISTER_RATE_LIMIT_WINDOW_MS=900000
REGISTER_RATE_LIMIT_MAX=10
